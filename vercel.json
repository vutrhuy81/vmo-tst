{
  "version": 2,
  "functions": {
    "api/ai-ocr-exam.js": {
      "maxDuration": 120
    },
    "api/ai-predict-exam.js": {
      "maxDuration": 300
    },
    "api/ai-exam-trends.js": {
      "maxDuration": 300
    },
    "api/ai-trend-theory.js": {
      "maxDuration": 300
    },
    "api/ai-guide.js": {
      "maxDuration": 300
    },
    "api/ai-evaluate-solution.js": {
      "maxDuration": 300
    },
    "api/data.js": {
      "maxDuration": 120,
      "includeFiles": "{index.html,assets/**,data/university-materials/**}"
    },
    "api/rag-worker.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/data?resource=app_shell"
    },
    {
      "source": "/index.html",
      "destination": "/api/data?resource=app_shell"
    },
    {
      "source": "/index_backup_before_auth.html",
      "destination": "/api/data?resource=blocked_static"
    },
    {
      "source": "/src/:path*",
      "destination": "/api/data?resource=blocked_static"
    },
    {
      "source": "/data/:path*",
      "destination": "/api/data?resource=blocked_static"
    },
    {
      "source": "/lib/:path*",
      "destination": "/api/data?resource=blocked_static"
    },
    {
      "source": "/scripts/:path*",
      "destination": "/api/data?resource=blocked_static"
    },
    {
      "source": "/test/:path*",
      "destination": "/api/data?resource=blocked_static"
    },
    {
      "source": "/docs/:path*",
      "destination": "/api/data?resource=blocked_static"
    },
    {
      "source": "/assets/:file*",
      "destination": "/api/data?resource=protected_asset&file=:file*"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/api/data?resource=app_shell"
    }
  ],
  "crons": [
    {
      "path": "/api/rag-worker",
      "schedule": "0 0 * * *"
    }
  ]
}
